# Set these in Vercel's dashboard under this project's Environment
# Variables — this file is a reference for local development only,
# never commit a real .env with real values in it.

# --- Firestore (from a Firebase service account) ---
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. That downloads a JSON file with exactly these 3 fields.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# The downloaded JSON has real line breaks in this value. Most dashboards
# (Vercel's included) don't handle multi-line env vars cleanly — paste it
# in as one line with literal \n characters instead of real line breaks;
# firestore.service.ts converts them back at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# --- Auth ---
# Any random secret string — used to sign JWTs. Generate one with e.g.
# `openssl rand -base64 32`, or any password generator.
JWT_SECRET="change-me-to-a-real-random-secret"
